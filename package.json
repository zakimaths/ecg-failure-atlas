{
  "name": "ecg-failure-atlas-checks",
  "version": "0.6.0",
  "private": true,
  "description": "Optional browser verification and demo recording; no JavaScript build step",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check:browser": "node scripts/browser-check.mjs",
    "record:demo": "node scripts/record-demo.mjs",
    "check:live": "uv run --locked python scripts/check-live.py",
    "check:lab": "node scripts/lab-browser-check.mjs",
    "check:clinical": "node scripts/clinical-browser-check.mjs",
    "check:motion": "node scripts/motion-browser-check.mjs",
    "check:batch": "node scripts/batch-browser-check.mjs",
    "check:beats": "node scripts/beats-browser-check.mjs",
    "check:stress": "node scripts/stress-browser-check.mjs"
  },
  "devDependencies": {
    "@playwright/cli": "0.1.19"
  }
}
